              "type": "string"
            },
            {
              "id": "field-name",
              "name": "name",
              "value": "={{ $json.body.name ?? $json.name ?? '' }}",
              "type": "string"
            },
            {
              "id": "field-max_uses",
              "name": "max_uses",
              "value": "={{ $json.body.max_uses ?? $json.max_uses ?? null }}",
              "type": "number"
            },
            {
              "id": "field-expires_at",
              "name": "expires_at",
              "value": "={{ $json.body.expires_at ?? $json.expires_at ?? null }}",
              "type": "string"
            },
            {
              "id": "field-notes",
              "name": "notes",
              "value": "={{ $json.body.notes ?? $json.notes ?? '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "set-fields",
      "name": "Prepare Fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://aggtrjiseqoeottcrbuw.supabase.co/functions/v1/generate-license",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "body": {
          "bodyParameters": {
            "parameters": [
              {
                "name": "email",
                "value": "={{ $json.email }}"
              },
              {
                "name": "name",
                "value": "={{ $json.name }}"
              },
              {
                "name": "max_uses",
                "value": "={{ $json.max_uses }}"
              },
              {
                "name": "expires_at",
                "value": "={{ $json.expires_at }}"
              },
              {
                "name": "notes",
                "value": "={{ $json.notes }}"
              }
            ]
          }
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "call-generate-license",
      "name": "Generate License",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "snapshot-ai-license-secret",
          "name": "Snapshot AI — License Secret"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-success",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 201,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-result",
      "name": "Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": true,\n  \"license_code\": \"{{ $('Generate License').item.json.body.license.license_code }}\",\n  \"email\": \"{{ $('Generate License').item.json.body.license.email }}\",\n  \"message\": \"License generated and email sent.\"\n}",
        "options": {
          "responseCode": 201
        }
      },
      "id": "respond-success",
      "name": "Respond — Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1120, 180]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"success\": false,\n  \"error\": \"{{ $('Generate License').item.json.body.error ?? 'Unknown error' }}\",\n  \"status\": {{ $('Generate License').item.json.statusCode }}\n}",
        "options": {
          "responseCode": "={{ $('Generate License').item.json.statusCode ?? 500 }}"
        }
      },
      "id": "respond-error",
      "name": "Respond — Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1120, 420]
    },
    {
      "parameters": {
        "content": "## Snapshot AI — Generate License\n\n**Trigger:** POST to this webhook with a JSON body.\n\n**Required field:**\n- `email` — customer email\n\n**Optional fields:**\n- `name` — customer name\n- `max_uses` — integer (null = unlimited)\n- `expires_at` — ISO 8601 date string (null = never)\n- `notes` — internal notes\n\n**Credential needed:**\nCreate an `HTTP Header Auth` credential named **Snapshot AI — License Secret** with:\n- Header: `Authorization`\n- Value: `Bearer <your GENERATE_LICENSE_SECRET>`\n\n**What it does:**\n1. Validates input\n2. Calls the Supabase edge function\n3. Edge function creates the license in DB and emails the customer via Resend\n4. Returns success or error response",
        "height": 380,
        "width": 360
      },
      "id": "sticky-docs",
      "name": "Docs",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [240, -120]
    }
  ],
